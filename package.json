{
  "name": "hreyfill-cli",
  "version": "0.1.0",
  "private": true,
  "description": "Unofficial Frogne Hreyfill CLI and MCP server",
  "type": "module",
  "bin": {
    "hreyfill": "src/index.ts"
  },
  "scripts": {
    "build": "bun build --compile src/index.ts --outfile hreyfill",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run typecheck && bun test",
    "verify:mcp": "bun scripts/verify-mcp.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "ajv": "8.20.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.11",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/axelpaul/Hreyfill-cli.git"
  },
  "homepage": "https://github.com/axelpaul/Hreyfill-cli#readme",
  "bugs": {
    "url": "https://github.com/axelpaul/Hreyfill-cli/issues"
  }
}
